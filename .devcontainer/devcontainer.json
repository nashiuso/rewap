{
  "name": "rewap",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm ci && npx playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [5173, 4321, 4322, 4174],
  "portsAttributes": {
    "5173": { "label": "Playground (dev)" },
    "4321": { "label": "Docs (preview)" },
    "4322": { "label": "Site (preview, mirrors GitHub Pages)" },
    "4174": { "label": "Playground (vite preview)" }
  }
}
