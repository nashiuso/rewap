# scripts/github/setup.conf.example
# ─────────────────────────────────────────────────────────────────────────────
# Configuration for scripts/github/setup.sh
#
# Copy to setup.conf (next to this file or at the repository root).
# The setup script sources it automatically when found.
# Values here override defaults; command-line flags override both.
#
# Do NOT put secrets, tokens or passwords in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Repository identity
REPO="nashiuso/rewap"
DEFAULT_BRANCH="main"

# Paths
REPO_PATH=""            # auto-detect from script location
BACKUP_DIR="./.setup-backups"

# Local Git configuration (leave empty to keep existing values)
GIT_USER_NAME=""        # your full name
GIT_USER_EMAIL=""       # your email address

# Features: set to 1 to enable, 0 to skip
ENABLE_DISCUSSIONS=1
ENABLE_WIKI=0
ENABLE_PROJECTS=0
AUTO_DELETE_HEAD_BRANCHES=1
SQUASH_MERGE_DEFAULT=1

# Branch protection
REQUIRE_PR_REVIEWS=0    # solo maintainer; set 1 if you want self-review gates
REQUIRED_CHECKS=""       # auto-detected; override as "check1,check2"

# Topics to add (comma-separated)
TOPICS="react,drag-and-drop,reorder,layout,typescript,accessibility"

# Description
DESCRIPTION="Draggable, swappable, reorderable React layouts. Framework-neutral core, small public API."

# Homepage URL
HOMEPAGE="https://nashiuso.github.io/rewap/"