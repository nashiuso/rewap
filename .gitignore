# Dependencies
node_modules/

# Build output
dist/
site-dist/
*.tsbuildinfo
*.tgz

# Generated by `npm run banner` (scripts/banner.mjs) — assets/ is the source
# of truth; these are disposable per-app copies.
docs/public/brand/
examples/playground/public/brand/

# Test artifacts
coverage/
test-results/
playwright-report/
blob-report/

# Framework build caches
.next/
.astro/
.turbo/

# Fumadocs' generated source index (regenerated from docs/content on every
# `next dev`/`next build`) and the docs site's static export output.
docs/.source/
docs/out/
docs/next-env.d.ts

# Editor/OS noise
.DS_Store
*.log
npm-debug.log*

# Local env files — the library and its tooling never need secrets to run,
# but a maintainer's shell might still drop one of these in by habit.
.env
.env.local
