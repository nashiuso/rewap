# Dependencies
node_modules/

# Build output
dist/
site-dist/
*.tsbuildinfo
*.tgz

# Generated by `npm run banner` (scripts/banner.mjs) — assets/ is the source
# of truth; these are disposable copies.
docs/public/brand/
docs/public/favicon.svg
docs/src/assets/brand/

# Test artifacts
coverage/
test-results/
playwright-report/
blob-report/

# Framework build caches
.astro/
.turbo/
docs/.astro/

# Editor/OS noise
.DS_Store
*.log
npm-debug.log*

# Local env files — the library and its tooling never need secrets to run,
# but a maintainer's shell might still drop one of these in by habit.
.env
.env.local

# Setup script backups
.setup-backups/