{
  "name": "@nashiuso/rewap",
  "version": "1.1.1",
  "description": "A React interaction library for draggable, swappable, reorderable and animated layouts. Local-first, dependency-light, TypeScript-native.",
  "license": "MIT",
  "author": "nashiuso (https://github.com/nashiuso)",
  "homepage": "https://nashiuso.github.io/rewap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nashiuso/rewap.git"
  },
  "bugs": {
    "url": "https://github.com/nashiuso/rewap/issues"
  },
  "keywords": [
    "react",
    "drag",
    "drop",
    "swap",
    "reorder",
    "sortable",
    "layout",
    "motion",
    "spring",
    "grid",
    "accessibility",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/types/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/types/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/types/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/types/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./math": {
      "import": {
        "types": "./dist/types/math/index.d.ts",
        "default": "./dist/math/index.js"
      },
      "require": {
        "types": "./dist/types/math/index.d.cts",
        "default": "./dist/math/index.cjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/types/motion/index.d.ts",
        "default": "./dist/motion/index.js"
      },
      "require": {
        "types": "./dist/types/motion/index.d.cts",
        "default": "./dist/motion/index.cjs"
      }
    },
    "./accessibility": {
      "import": {
        "types": "./dist/types/accessibility/index.d.ts",
        "default": "./dist/accessibility/index.js"
      },
      "require": {
        "types": "./dist/types/accessibility/index.d.cts",
        "default": "./dist/accessibility/index.cjs"
      }
    },
    "./utilities": {
      "import": {
        "types": "./dist/types/utilities/index.d.ts",
        "default": "./dist/utilities/index.js"
      },
      "require": {
        "types": "./dist/types/utilities/index.d.cts",
        "default": "./dist/utilities/index.cjs"
      }
    },
    "./providers": {
      "import": {
        "types": "./dist/types/providers/index.d.ts",
        "default": "./dist/providers/index.js"
      },
      "require": {
        "types": "./dist/types/providers/index.d.cts",
        "default": "./dist/providers/index.cjs"
      }
    },
    "./charts": {
      "import": {
        "types": "./dist/types/charts/index.d.ts",
        "default": "./dist/charts/index.js"
      },
      "require": {
        "types": "./dist/types/charts/index.d.cts",
        "default": "./dist/charts/index.cjs"
      }
    },
    "./widgets": {
      "import": {
        "types": "./dist/types/widgets/index.d.ts",
        "default": "./dist/widgets/index.js"
      },
      "require": {
        "types": "./dist/types/widgets/index.d.cts",
        "default": "./dist/widgets/index.cjs"
      }
    },
    "./styles.css": "./dist/styles/rewap.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./charts.css": "./dist/styles/charts.css",
    "./widgets.css": "./dist/styles/widgets.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "workspaces": [
    "docs",
    "examples/playground"
  ],
  "scripts": {
    "build": "tsup && npm run build:types && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:examples": "tsc --noEmit -p examples/playground/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs",
    "size": "node scripts/size.mjs",
    "banner": "node scripts/banner.mjs",
    "docs:build": "npm run banner && npm run build --workspace docs",
    "docs:dev": "npm run dev --workspace docs",
    "examples:dev": "npm run banner && npm run dev --workspace @nashiuso/rewap-playground",
    "examples:build": "npm run banner && npm run build --workspace @nashiuso/rewap-playground",
    "examples:preview": "npm run preview --workspace @nashiuso/rewap-playground",
    "test:e2e": "playwright test",
    "ci": "npm run format:check && npm run typecheck && npm run typecheck:examples && npm run lint && npm test && npm run build && npm run lint:package && npm run verify:package && npm run test:types",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:package": "npm run build && publint --strict",
    "site:build": "node scripts/site/build.mjs",
    "site:preview": "node scripts/site/preview.mjs",
    "verify:release": "npm run ci && npm run examples:build && npm run docs:build && npm run test:e2e && npm pack --dry-run",
    "build:types": "tsc -p tsconfig.build.json && node scripts/build-types.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.1",
    "publint": "^0.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rewap": "./dist/cli/index.js"
  }
}
